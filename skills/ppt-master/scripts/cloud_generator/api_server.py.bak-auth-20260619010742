    awarded = _grant_bonus_credits(
        store,
        referrer_id,
        _limit_int("PPT_MASTER_REFERRAL_COMPLETION_BONUS_CREDITS", 50),
        "referral_first_generation_bonus",
        {"event_key": f"referral_completed:{user_id}", "referred_user_id": user_id},
